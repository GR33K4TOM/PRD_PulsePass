# =============================================================================
# Plantilla de Variables de Entorno para Pruebas E2E (Bash + cURL)
# Copiar a post-tests/.env.e2e antes de ejecutar los scripts:
#   cp post-tests/.env.e2e.example post-tests/.env.e2e
# =============================================================================

# URL base de la API en ejecución
BASE_URL=http://localhost:8080

# Conexión a PostgreSQL (usada únicamente por 00_setup_fixtures.sh para aplicar seed-e2e.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulsepass
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_DB_PASSWORD_LOCAL
# Opcional: nombre del contenedor Docker si PostgreSQL corre en Docker y no hay cliente psql local
DOCKER_PG_CONTAINER=

# Identificador único de corrida (evita colisiones en ejecuciones repetidas)
RUN_ID=run01

# Actores de registro público (USER_A y USER_B)
USER_A_USERNAME=andrea_run01
USER_A_EMAIL=andrea.run01@example.test
USER_A_PASSWORD=REEMPLAZAR_PASSWORD_LOCAL_12_CHARS

USER_B_USERNAME=carlos_run01
USER_B_EMAIL=carlos.run01@example.test
USER_B_PASSWORD=REEMPLAZAR_PASSWORD_LOCAL_12_CHARS

# Actores preprovisionados en BD de pruebas (ADMIN, STAFF e INACTIVE_USER)
ADMIN_IDENTIFIER=admin_e2e
ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_LOCAL_12_CHARS

STAFF_IDENTIFIER=laura_staff
STAFF_PASSWORD=REEMPLAZAR_PASSWORD_LOCAL_12_CHARS

INACTIVE_IDENTIFIER=miguel_inactivo
INACTIVE_PASSWORD=REEMPLAZAR_PASSWORD_LOCAL_12_CHARS

# Fixtures de catálogo
VENUE_ACTIVE_CODE=VEN-SMR-01
VENUE_INACTIVE_CODE=VEN-INACTIVE-01
ARTIST_ID=1
ARTIST_STAGE_NAME=Solar Beat

# Códigos de eventos
DRAFT_EVENT_CODE=EVT-SEED-DRAFT
PUBLISHED_EVENT_CODE=CMF-2026
EVENT_TO_PUBLISH_CODE=EVT-E2E-run01

# Códigos de tickets (se completan automáticamente tras la compra en FR-E2E-004)
TICKET_CANCELABLE_CODE=
TICKET_USABLE_CODE=
USER_B_TICKET_CODE=

# Tokens locales por actor (se guardan en post-tests/.tokens.env tras ejecutar FR-E2E-002; NO versionar)
USER_A_TOKEN=
USER_B_TOKEN=
STAFF_TOKEN=
ADMIN_TOKEN=

# Parámetros de contrato esperados
EXPECTED_ISSUER=pulsepass-api
EXPECTED_TOKEN_TTL_SECONDS=900
EXPECTED_FOREIGN_RESOURCE_STATUS=403
